<script>
/* ── Color picker sync ── */
document.querySelectorAll('.cf-color-input').forEach(function(colorInput) {
    var textInput = colorInput.parentElement.querySelector('.cf-color-text');
    if (textInput) {
        colorInput.addEventListener('input', function() { textInput.value = this.value; });
        textInput.addEventListener('input', function() {
            if (/^#[0-9a-fA-F]{6}$/.test(this.value)) colorInput.value = this.value;
        });
    }
});

/* ── Language switcher (scoped to parent container) ── */
document.querySelectorAll('.cf-lang-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var langId = this.dataset.langId;
        // Scope: find the closest container (either .cf-lang-selector parent or whole page)
        var scope = this.closest('.cf-admin-modal__body') || this.closest('.cf-module-wrapper');
        if (!scope) return;
        // Update active button within same selector group
        var selector = this.closest('.cf-lang-selector');
        if (selector) {
            selector.querySelectorAll('.cf-lang-btn').forEach(function(b) { b.classList.remove('cf-lang-btn--active'); });
        }
        this.classList.add('cf-lang-btn--active');
        // Toggle fields within scope
        scope.querySelectorAll('.cf-lang-field').forEach(function(f) {
            f.style.display = f.dataset.langId == langId ? '' : 'none';
        });
    });
});

/* ── Cookie definition modal ── */
function cfShowCookieForm() {
    document.getElementById('cf-cookie-modal').style.display = '';
    document.getElementById('cf-cookie-modal-title').textContent = 'Add cookie definition';
    document.getElementById('cf-cookie-id').value = '0';
    document.getElementById('cf-cookie-category').value = 'necessary';
    document.getElementById('cf-cookie-name').value = '';
    document.getElementById('cf-cookie-provider').value = '';
    document.getElementById('cf-cookie-duration').value = '';
    document.getElementById('cf-cookie-position').value = '0';
    document.querySelectorAll('[id^="cf-cookie-desc-"]').forEach(function(t) { t.value = ''; });
}

/* Cookie descriptions per lang — injected from PHP */
var cfCookieDescriptions = JSON.parse('{{ cookieDescriptions|default({})|json_encode|e('js') }}');

function cfEditCookie(cookie) {
    document.getElementById('cf-cookie-modal').style.display = '';
    document.getElementById('cf-cookie-modal-title').textContent = 'Edit cookie definition';
    document.getElementById('cf-cookie-id').value = cookie.id_cookie_def;
    document.getElementById('cf-cookie-category').value = cookie.category;
    document.getElementById('cf-cookie-name').value = cookie.cookie_name;
    document.getElementById('cf-cookie-provider').value = cookie.provider || '';
    document.getElementById('cf-cookie-duration').value = cookie.duration || '';
    document.getElementById('cf-cookie-position').value = cookie.position || '0';
    // Fill descriptions for all languages
    var descs = cfCookieDescriptions[cookie.id_cookie_def] || {};
    document.querySelectorAll('[id^="cf-cookie-desc-"]').forEach(function(t) {
        var langId = t.id.replace('cf-cookie-desc-', '');
        t.value = descs[langId] || '';
    });
}

function cfCloseCookieForm() {
    document.getElementById('cf-cookie-modal').style.display = 'none';
}

/* ── Consent Logs (AJAX) ── */
var cfLogsUrl = '{{ logsUrl }}';
var cfExportUrl = '{{ exportLogsUrl }}';

function cfLoadLogs(page) {
    var params = new URLSearchParams();
    params.set('page', page || 1);
    var dateFrom = document.getElementById('cf-log-date-from');
    var dateTo = document.getElementById('cf-log-date-to');
    var actionFilter = document.getElementById('cf-log-action-filter');
    if (dateFrom && dateFrom.value) params.set('date_from', dateFrom.value);
    if (dateTo && dateTo.value) params.set('date_to', dateTo.value);
    if (actionFilter && actionFilter.value) params.set('action_filter', actionFilter.value);

    var logsSep = cfLogsUrl.indexOf('?') > -1 ? '&' : '?';
    var exportSep = cfExportUrl.indexOf('?') > -1 ? '&' : '?';

    // Update export link
    var exportBtn = document.getElementById('cf-export-btn');
    if (exportBtn) exportBtn.href = cfExportUrl + exportSep + params.toString();

    var container = document.getElementById('cf-logs-container');
    container.innerHTML = '<div class="cf-loading">Loading...</div>';

    fetch(cfLogsUrl + logsSep + params.toString())
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.logs || data.logs.length === 0) {
                container.innerHTML = '<div class="cf-empty-state"><i class="material-icons">inbox</i><p>No logs found.</p></div>';
                document.getElementById('cf-logs-pagination').style.display = 'none';
                return;
            }

            var html = '<table class="cf-table"><thead><tr>';
            html += '<th>ID</th><th>Date</th><th>Customer</th><th>Action</th>';
            html += '<th>Analytics</th><th>Marketing</th><th>Functional</th>';
            html += '<th>Policy</th><th>A/B</th><th>IP</th></tr></thead><tbody>';

            /* Escape HTML to prevent XSS from database values */
            function esc(str) {
                if (!str) return '';
                var d = document.createElement('div');
                d.appendChild(document.createTextNode(String(str)));
                return d.innerHTML;
            }

            data.logs.forEach(function(log) {
                var customer = log.firstname ? (esc(log.firstname) + ' ' + esc(log.lastname)) : ('Guest #' + esc(log.id_guest || '?'));
                var actionSafe = esc(log.action);
                var actionClass = 'cf-action-badge cf-action-badge--' + actionSafe;
                html += '<tr>';
                html += '<td><span class="cf-id-badge">' + esc(log.id_consent_log) + '</span></td>';
                html += '<td>' + esc(log.date_add) + '</td>';
                html += '<td>' + customer + '</td>';
                html += '<td><span class="' + actionClass + '">' + actionSafe + '</span></td>';
                html += '<td>' + (log.consent_analytics == 1 ? '<span class="cf-consent-yes">&#10003;</span>' : '<span class="cf-consent-no">&#10007;</span>') + '</td>';
                html += '<td>' + (log.consent_marketing == 1 ? '<span class="cf-consent-yes">&#10003;</span>' : '<span class="cf-consent-no">&#10007;</span>') + '</td>';
                html += '<td>' + (log.consent_functional == 1 ? '<span class="cf-consent-yes">&#10003;</span>' : '<span class="cf-consent-no">&#10007;</span>') + '</td>';
                html += '<td>v' + esc(log.policy_version) + '</td>';
                html += '<td>' + esc(log.ab_variant || '—') + '</td>';
                html += '<td>' + esc(log.ip_address || '') + '</td>';
                html += '</tr>';
            });
            html += '</tbody></table>';
            container.innerHTML = html;

            // Pagination
            var pag = document.getElementById('cf-logs-pagination');
            if (data.pages > 1) {
                var ph = '<span class="cf-pagination__info">' + data.total + ' records, page ' + data.page + '/' + data.pages + '</span>';
                ph += '<div class="cf-pagination__buttons">';
                if (data.page > 1) ph += '<button class="cf-btn cf-btn--outline cf-btn--sm" onclick="cfLoadLogs(' + (data.page - 1) + ')">Prev</button>';
                if (data.page < data.pages) ph += '<button class="cf-btn cf-btn--outline cf-btn--sm" onclick="cfLoadLogs(' + (data.page + 1) + ')">Next</button>';
                ph += '</div>';
                pag.innerHTML = ph;
                pag.style.display = '';
            } else {
                pag.style.display = 'none';
            }
        })
        .catch(function(err) {
            container.innerHTML = '<div class="cf-empty-state"><i class="material-icons">error</i><p>Error loading logs.</p></div>';
        });
}

/* ── Tab switching (JS-based, no page reload) ── */
var cfLogsLoaded = false;
document.querySelectorAll('.cf-tab[data-cf-tab]').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var tab = this.dataset.cfTab;
        // Update active tab button
        document.querySelectorAll('.cf-tab[data-cf-tab]').forEach(function(b) { b.classList.remove('cf-tab-active'); });
        this.classList.add('cf-tab-active');
        // Show/hide panels
        document.querySelectorAll('[data-cf-panel]').forEach(function(p) {
            p.style.display = p.dataset.cfPanel === tab ? '' : 'none';
        });
        // Lazy-load logs on first visit to logs tab
        if (tab === 'logs' && !cfLogsLoaded) {
            cfLogsLoaded = true;
            cfLoadLogs(1);
        }
        // Update URL hash for bookmarking
        history.replaceState(null, '', '#' + tab);
    });
});

// Restore tab from URL hash on page load
(function() {
    var hash = window.location.hash.replace('#', '');
    if (hash) {
        var btn = document.querySelector('.cf-tab[data-cf-tab="' + hash + '"]');
        if (btn) btn.click();
    }
})();
</script>
{% endblock %}
