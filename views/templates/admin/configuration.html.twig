{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ adminCssPath }}?v={{ moduleVersion }}">
    <link rel="stylesheet" href="{{ quincePromoCssPath }}?v={{ moduleVersion }}">
{% endblock %}

{% block content %}
<div class="cf-module-wrapper">

    {# ─── TABS (JS-based, no page reload) ─── #}
    <div class="cf-tabs-container">
        <button type="button" class="cf-tab cf-tab-active" data-cf-tab="settings">
            <i class="material-icons">settings</i> {{ 'Settings'|trans({}, 'Modules.Consentflow.Admin') }}
        </button>
        <button type="button" class="cf-tab" data-cf-tab="texts">
            <i class="material-icons">translate</i> {{ 'Texts'|trans({}, 'Modules.Consentflow.Admin') }}
        </button>
        <button type="button" class="cf-tab" data-cf-tab="cookies">
            <i class="material-icons">list_alt</i> {{ 'Cookie Definitions'|trans({}, 'Modules.Consentflow.Admin') }}
        </button>
        <button type="button" class="cf-tab" data-cf-tab="logs">
            <i class="material-icons">history</i> {{ 'Consent Log'|trans({}, 'Modules.Consentflow.Admin') }}
            <span class="cf-badge">{{ logCount }}</span>
        </button>
        <button type="button" class="cf-tab" data-cf-tab="support">
            <i class="material-icons">favorite</i> {{ 'Support the author'|trans({}, 'Modules.Consentflow.Admin') }}
        </button>
    </div>

    {# ─── FLASH MESSAGES ─── #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="cf-alert cf-alert--{{ type }}">
                {{ message }}
                <button type="button" class="cf-alert__close" onclick="this.parentElement.remove()">&times;</button>
            </div>
        {% endfor %}
    {% endfor %}

    {# ============================================================
       TAB 1: SETTINGS
       ============================================================ #}
    <div data-cf-panel="settings">
    <form method="post" action="{{ path('consentflow_configuration') }}">
        <input type="hidden" name="cf_tab" value="settings">
        <input type="hidden" name="_token" value="{{ csrf_token('consentflow') }}">

        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">tune</i> {{ 'General Settings'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">

                {# Enable module #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Enable module'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_ENABLED" value="1" {% if settings.CONSENTFLOW_ENABLED == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                        <span class="cf-form-hint">{{ 'Master switch — when off, no banner is shown and no assets are loaded.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>

                {# Policy version #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Policy version'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <input type="number" name="CONSENTFLOW_POLICY_VERSION" value="{{ settings.CONSENTFLOW_POLICY_VERSION }}" min="1" class="cf-input cf-input--sm">
                        <span class="cf-form-hint">{{ 'Increment to force all users to re-consent.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>

                {# Cookie lifetime #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Cookie lifetime (days)'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <input type="number" name="CONSENTFLOW_COOKIE_LIFETIME" value="{{ settings.CONSENTFLOW_COOKIE_LIFETIME }}" min="1" max="730" class="cf-input cf-input--sm">
                    </div>
                </div>

                {# Banner position #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Banner position'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <select name="CONSENTFLOW_BANNER_POSITION" class="cf-select">
                            <option value="bottom" {% if settings.CONSENTFLOW_BANNER_POSITION == 'bottom' %}selected{% endif %}>Bottom</option>
                            <option value="top" {% if settings.CONSENTFLOW_BANNER_POSITION == 'top' %}selected{% endif %}>Top</option>
                            <option value="center" {% if settings.CONSENTFLOW_BANNER_POSITION == 'center' %}selected{% endif %}>Center (Modal)</option>
                        </select>
                    </div>
                </div>

                {# Show floating button #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Show floating button'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_SHOW_FLOAT_BTN" value="1" {% if settings.CONSENTFLOW_SHOW_FLOAT_BTN == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                    </div>
                </div>

                {# Float button position #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Floating button position'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <select name="CONSENTFLOW_FLOAT_BTN_POSITION" class="cf-select">
                            <option value="bottom-left" {% if settings.CONSENTFLOW_FLOAT_BTN_POSITION == 'bottom-left' %}selected{% endif %}>Bottom-left</option>
                            <option value="bottom-right" {% if settings.CONSENTFLOW_FLOAT_BTN_POSITION == 'bottom-right' %}selected{% endif %}>Bottom-right</option>
                        </select>
                    </div>
                </div>

                {# Google Consent Mode #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Google Consent Mode v2'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_GOOGLE_CONSENT" value="1" {% if settings.CONSENTFLOW_GOOGLE_CONSENT == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                        <span class="cf-form-hint">{{ 'Fire gtag("consent","update",...) on every consent change.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>

                {# Show functional category #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Show Functional category'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_SHOW_FUNCTIONAL" value="1" {% if settings.CONSENTFLOW_SHOW_FUNCTIONAL == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                        <span class="cf-form-hint">{{ 'When off, functional cookies are bundled with necessary.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>
            </div>

            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
                    <i class="material-icons">save</i> {{ 'Save settings'|trans({}, 'Modules.Consentflow.Admin') }}
                </button>
            </div>
        </div>

        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">storage</i> {{ 'Logging & Compliance'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">

                {# Log consent #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Log consent to database'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_LOG_CONSENT" value="1" {% if settings.CONSENTFLOW_LOG_CONSENT == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                    </div>
                </div>

                {# Log retention #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Log retention (days)'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <input type="number" name="CONSENTFLOW_LOG_RETENTION" value="{{ settings.CONSENTFLOW_LOG_RETENTION }}" min="30" max="3650" class="cf-input cf-input--sm">
                        <span class="cf-form-hint">{{ 'Logs older than this are automatically purged. Default: 730 days (2 years).'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>

                {# Privacy policy CMS page #}
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Privacy policy page'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <select name="CONSENTFLOW_PRIVACY_CMS_ID" class="cf-select">
                            <option value="0">— {{ 'None'|trans({}, 'Admin.Global') }} —</option>
                            {% for page in cmsPages %}
                                <option value="{{ page.id_cms }}" {% if settings.CONSENTFLOW_PRIVACY_CMS_ID == page.id_cms %}selected{% endif %}>{{ page.meta_title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
                    <i class="material-icons">save</i> {{ 'Save settings'|trans({}, 'Modules.Consentflow.Admin') }}
                </button>
            </div>
        </div>

        {# ── Appearance Card ── #}
        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">palette</i> {{ 'Appearance'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Primary color'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control cf-color-row">
                        <input type="color" name="CONSENTFLOW_COLOR_PRIMARY" value="{{ settings.CONSENTFLOW_COLOR_PRIMARY|default('#2563eb') }}" class="cf-color-input">
                        <input type="text" value="{{ settings.CONSENTFLOW_COLOR_PRIMARY|default('#2563eb') }}" class="cf-input cf-input--sm cf-color-text" data-color-for="CONSENTFLOW_COLOR_PRIMARY" pattern="^#[0-9a-fA-F]{6}$">
                        <span class="cf-form-hint">{{ 'Accept button, toggles, links.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Primary hover'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control cf-color-row">
                        <input type="color" name="CONSENTFLOW_COLOR_PRIMARY_HOVER" value="{{ settings.CONSENTFLOW_COLOR_PRIMARY_HOVER|default('#1d4ed8') }}" class="cf-color-input">
                        <input type="text" value="{{ settings.CONSENTFLOW_COLOR_PRIMARY_HOVER|default('#1d4ed8') }}" class="cf-input cf-input--sm cf-color-text" data-color-for="CONSENTFLOW_COLOR_PRIMARY_HOVER" pattern="^#[0-9a-fA-F]{6}$">
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Background color'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control cf-color-row">
                        <input type="color" name="CONSENTFLOW_COLOR_BG" value="{{ settings.CONSENTFLOW_COLOR_BG|default('#ffffff') }}" class="cf-color-input">
                        <input type="text" value="{{ settings.CONSENTFLOW_COLOR_BG|default('#ffffff') }}" class="cf-input cf-input--sm cf-color-text" data-color-for="CONSENTFLOW_COLOR_BG" pattern="^#[0-9a-fA-F]{6}$">
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Text color'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control cf-color-row">
                        <input type="color" name="CONSENTFLOW_COLOR_TEXT" value="{{ settings.CONSENTFLOW_COLOR_TEXT|default('#1f2937') }}" class="cf-color-input">
                        <input type="text" value="{{ settings.CONSENTFLOW_COLOR_TEXT|default('#1f2937') }}" class="cf-input cf-input--sm cf-color-text" data-color-for="CONSENTFLOW_COLOR_TEXT" pattern="^#[0-9a-fA-F]{6}$">
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Button text color'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control cf-color-row">
                        <input type="color" name="CONSENTFLOW_COLOR_BTN_TEXT" value="{{ settings.CONSENTFLOW_COLOR_BTN_TEXT|default('#ffffff') }}" class="cf-color-input">
                        <input type="text" value="{{ settings.CONSENTFLOW_COLOR_BTN_TEXT|default('#ffffff') }}" class="cf-input cf-input--sm cf-color-text" data-color-for="CONSENTFLOW_COLOR_BTN_TEXT" pattern="^#[0-9a-fA-F]{6}$">
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Border radius (px)'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <input type="number" name="CONSENTFLOW_BORDER_RADIUS" value="{{ settings.CONSENTFLOW_BORDER_RADIUS|default('8') }}" min="0" max="24" class="cf-input cf-input--sm">
                    </div>
                </div>
            </div>
            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
                    <i class="material-icons">save</i> {{ 'Save settings'|trans({}, 'Modules.Consentflow.Admin') }}
                </button>
            </div>
        </div>

        {# ── Iframe Blocking Card ── #}
        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">web_asset</i> {{ 'Iframe Blocking'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Block iframes until consent'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_IFRAME_BLOCKING" value="1" {% if settings.CONSENTFLOW_IFRAME_BLOCKING == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                        <span class="cf-form-hint">{{ 'Replace YouTube, Google Maps, and social embeds with a placeholder until marketing cookies are accepted. Iframes must have data-consentflow="marketing" attribute.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>
            </div>
            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
                    <i class="material-icons">save</i> {{ 'Save settings'|trans({}, 'Modules.Consentflow.Admin') }}
                </button>
            </div>
        </div>

        {# ── A/B Testing Card ── #}
        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">science</i> {{ 'A/B Testing'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Enable A/B testing'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <label class="cf-toggle">
                            <input type="checkbox" name="CONSENTFLOW_AB_ENABLED" value="1" {% if settings.CONSENTFLOW_AB_ENABLED == '1' %}checked{% endif %}>
                            <span class="cf-toggle__slider"></span>
                        </label>
                        <span class="cf-form-hint">{{ 'Randomly show banner in variant A (normal position) or B (alternative) to compare acceptance rates.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Variant A position'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <span class="cf-form-hint">{{ 'Uses the main Banner position setting above.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Variant B position'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <select name="CONSENTFLOW_AB_VARIANT_B_POSITION" class="cf-select">
                            <option value="bottom" {% if settings.CONSENTFLOW_AB_VARIANT_B_POSITION == 'bottom' %}selected{% endif %}>Bottom</option>
                            <option value="top" {% if settings.CONSENTFLOW_AB_VARIANT_B_POSITION == 'top' %}selected{% endif %}>Top</option>
                            <option value="center" {% if settings.CONSENTFLOW_AB_VARIANT_B_POSITION == 'center' %}selected{% endif %}>Center (Modal)</option>
                        </select>
                    </div>
                </div>
                <div class="cf-form-group">
                    <label class="cf-label">{{ 'Traffic split (% for variant A)'|trans({}, 'Modules.Consentflow.Admin') }}</label>
                    <div class="cf-form-control">
                        <input type="number" name="CONSENTFLOW_AB_SPLIT" value="{{ settings.CONSENTFLOW_AB_SPLIT|default('50') }}" min="10" max="90" class="cf-input cf-input--sm">
                        <span class="cf-form-hint">{{ '50 = equal split. 70 = 70% variant A, 30% variant B.'|trans({}, 'Modules.Consentflow.Admin') }}</span>
                    </div>
                </div>
            </div>
            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
                    <i class="material-icons">save</i> {{ 'Save settings'|trans({}, 'Modules.Consentflow.Admin') }}
                </button>
            </div>
        </div>
    </form>

    {# ============================================================
       TAB 2: TEXTS
       ============================================================ #}
    </div>{# /settings panel #}

    <div data-cf-panel="texts" style="display:none">
    <form method="post" action="{{ path('consentflow_configuration') }}">
        <input type="hidden" name="cf_tab" value="texts">
        <input type="hidden" name="_token" value="{{ csrf_token('consentflow') }}">

        {# Language selector #}
        <div class="cf-lang-selector">
            {% for lang in languages %}
                <button type="button" class="cf-lang-btn{% if lang.id_lang == currentLangId %} cf-lang-btn--active{% endif %}" data-lang-id="{{ lang.id_lang }}">
                    {{ lang.iso_code|upper }}
                </button>
            {% endfor %}
        </div>

        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">text_fields</i> {{ 'Banner Texts'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">
                {% set bannerFields = {
                    'CONSENTFLOW_BANNER_TITLE': 'Banner title',
                    'CONSENTFLOW_BANNER_TEXT': 'Banner text',
                    'CONSENTFLOW_BTN_ACCEPT_ALL': 'Accept All button',
                    'CONSENTFLOW_BTN_REJECT_ALL': 'Reject All button',
                    'CONSENTFLOW_BTN_PREFERENCES': 'Preferences button',
                    'CONSENTFLOW_BTN_SAVE': 'Save preferences button',
                    'CONSENTFLOW_FLOAT_BTN_LABEL': 'Floating button label',
                    'CONSENTFLOW_PRIVACY_LINK_TEXT': 'Privacy policy link text',
                    'CONSENTFLOW_IFRAME_PLACEHOLDER_TEXT': 'Iframe placeholder text',
                    'CONSENTFLOW_IFRAME_PLACEHOLDER_BTN': 'Iframe placeholder button'
                } %}

                {% for key, label in bannerFields %}
                    <div class="cf-form-group">
                        <label class="cf-label">{{ label|trans({}, 'Modules.Consentflow.Admin') }}</label>
                        <div class="cf-form-control">
                            {% for lang in languages %}
                                <div class="cf-lang-field" data-lang-id="{{ lang.id_lang }}" {% if lang.id_lang != currentLangId %}style="display:none"{% endif %}>
                                    {% if key == 'CONSENTFLOW_BANNER_TEXT' %}
                                        <textarea name="{{ key }}_{{ lang.id_lang }}" class="cf-textarea" rows="3">{{ texts[key][lang.id_lang]|default('') }}</textarea>
                                    {% else %}
                                        <input type="text" name="{{ key }}_{{ lang.id_lang }}" value="{{ texts[key][lang.id_lang]|default('') }}" class="cf-input">
                                    {% endif %}
                                    <span class="cf-lang-indicator">{{ lang.iso_code|upper }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">category</i> {{ 'Category Texts'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">
                {% set catFields = {
                    'CONSENTFLOW_CAT_NECESSARY_TITLE': 'Necessary — title',
                    'CONSENTFLOW_CAT_NECESSARY_DESC': 'Necessary — description',
                    'CONSENTFLOW_CAT_ANALYTICS_TITLE': 'Analytics — title',
                    'CONSENTFLOW_CAT_ANALYTICS_DESC': 'Analytics — description',
                    'CONSENTFLOW_CAT_MARKETING_TITLE': 'Marketing — title',
                    'CONSENTFLOW_CAT_MARKETING_DESC': 'Marketing — description',
                    'CONSENTFLOW_CAT_FUNCTIONAL_TITLE': 'Functional — title',
                    'CONSENTFLOW_CAT_FUNCTIONAL_DESC': 'Functional — description'
                } %}

                {% for key, label in catFields %}
                    <div class="cf-form-group">
                        <label class="cf-label">{{ label|trans({}, 'Modules.Consentflow.Admin') }}</label>
                        <div class="cf-form-control">
                            {% for lang in languages %}
                                <div class="cf-lang-field" data-lang-id="{{ lang.id_lang }}" {% if lang.id_lang != currentLangId %}style="display:none"{% endif %}>
                                    {% if 'DESC' in key %}
                                        <textarea name="{{ key }}_{{ lang.id_lang }}" class="cf-textarea" rows="2">{{ texts[key][lang.id_lang]|default('') }}</textarea>
                                    {% else %}
                                        <input type="text" name="{{ key }}_{{ lang.id_lang }}" value="{{ texts[key][lang.id_lang]|default('') }}" class="cf-input">
                                    {% endif %}
                                    <span class="cf-lang-indicator">{{ lang.iso_code|upper }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
                    <i class="material-icons">save</i> {{ 'Save texts'|trans({}, 'Modules.Consentflow.Admin') }}
                </button>
            </div>
        </div>

        <div class="cf-card">
            <div class="cf-card__header">
                <i class="material-icons">table_chart</i> {{ 'Cookie Table & Badges'|trans({}, 'Modules.Consentflow.Admin') }}
            </div>
            <div class="cf-card__body">
                {% set tableFields = {
                    'CONSENTFLOW_CAT_ALWAYS_ACTIVE': 'Always-active badge',
                    'CONSENTFLOW_TABLE_COOKIE': 'Cookie table — Cookie column',
                    'CONSENTFLOW_TABLE_PROVIDER': 'Cookie table — Provider column',
                    'CONSENTFLOW_TABLE_DURATION': 'Cookie table — Duration column',
                    'CONSENTFLOW_TABLE_DESCRIPTION': 'Cookie table — Description column'
                } %}

                {% for key, label in tableFields %}
                    <div class="cf-form-group">
                        <label class="cf-label">{{ label|trans({}, 'Modules.Consentflow.Admin') }}</label>
                        <div class="cf-form-control">
                            {% for lang in languages %}
                                <div class="cf-lang-field" data-lang-id="{{ lang.id_lang }}" {% if lang.id_lang != currentLangId %}style="display:none"{% endif %}>
                                    <input type="text" name="{{ key }}_{{ lang.id_lang }}" value="{{ texts[key][lang.id_lang]|default('') }}" class="cf-input">
                                    <span class="cf-lang-indicator">{{ lang.iso_code|upper }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="cf-card__footer">
                <button type="submit" class="cf-btn cf-btn--primary">
